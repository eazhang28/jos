[32m+[m[32m// This function returns the physical address of the page containing 'va',[m
[32m+[m[32m// defined by the page directory 'pgdir'.  The hardware normally performs[m
[32m+[m[32m// this functionality for us!  We define our own version to help check[m
[32m+[m[32m// the check_kern_pgdir() function; it shouldn't be used elsewhere.[m
[32m+[m
[32m+[m[32mstatic physaddr_t[m
[32m+[m[32mcheck_va2pa(pde_t *pgdir, uintptr_t va)[m
[32m+[m[32m{[m
[32m+[m	[32mpte_t *p;[m
[32m+[m
[32m+[m	[32mpgdir = &pgdir[PDX(va)];[m
[32m+[m	[32mif (!(*pgdir & PTE_P))[m
[32m+[m		[32mreturn ~0;[m
[32m+[m	[32mp = (pte_t*) KADDR(PTE_ADDR(*pgdir));[m
[32m+[m	[32mif (!(p[PTX(va)] & PTE_P))[m
[32m+[m		[32mreturn ~0;[m
