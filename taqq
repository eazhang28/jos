[32m+[m	[32massert(page_insert(kern_pgdir, pp1, 0x0, PTE_W) == 0);[m
[32m+[m	[32massert(PTE_ADDR(kern_pgdir[0]) == page2pa(pp0));[m
[32m+[m	[32massert(check_va2pa(kern_pgdir, 0x0) == page2pa(pp1));[m
[32m+[m	[32massert(pp1->pp_ref == 1);[m
[32m+[m	[32massert(pp0->pp_ref == 1);[m
[32m+[m
[32m+[m	[32m// should be able to map pp2 at PGSIZE because pp0 is already allocated for page table[m
[32m+[m	[32massert(page_insert(kern_pgdir, pp2, (void*) PGSIZE, PTE_W) == 0);[m
[32m+[m	[32massert(check_va2pa(kern_pgdir, PGSIZE) == page2pa(pp2));[m
[32m+[m	[32massert(pp2->pp_ref == 1);[m
[32m+[m
[32m+[m	[32m// should be no free memory[m
[32m+[m	[32massert(!page_alloc(0));[m
[32m+[m
[32m+[m	[32m// should be able to map pp2 at PGSIZE because it's already there[m
[32m+[m	[32massert(page_insert(kern_pgdir, pp2, (void*) PGSIZE, PTE_W) == 0);[m
[32m+[m	[32massert(check_va2pa(kern_pgdir, PGSIZE) == page2pa(pp2));[m
