[32m+[m			[32mif (i >= PDX(KERNBASE)) {[m
[32m+[m				[32massert(pgdir[i] & PTE_P);[m
[32m+[m				[32massert(pgdir[i] & PTE_W);[m
[32m+[m			[32m} else[m
[32m+[m				[32massert(pgdir[i] == 0);[m
[32m+[m			[32mbreak;[m
[32m+[m		[32m}[m
[32m+[m	[32m}[m
[32m+[m	[32mcprintf("check_kern_pgdir() succeeded!\n");[m
